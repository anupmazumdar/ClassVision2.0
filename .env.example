# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Cryptographic Keys (min 32 chars)
JWT_SECRET=your-jwt-secret-signing-key-min32chars
SESSION_CODE_SECRET=your-session-code-hmac-secret-min32chars
ATTENDANCE_TICKET_SECRET=your-attendance-ticket-hmac-secret-min32chars
FACE_ENCRYPTION_KEY=your-fernet-32byte-base64-encryption-key

# Default Admin Credentials
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@classvision.local
ADMIN_PASSWORD=your-secure-admin-password

# Token Policies
TOKEN_EXPIRE_HOURS=8
CODE_EXPIRATION_SECONDS=30
TICKET_EXPIRATION_SECONDS=15

