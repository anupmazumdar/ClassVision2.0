# ==============================================================================
# CLASSVISION 2.0 - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` in the `backend/` directory (or workspace root) and 
# fill in production-ready values. Generate secure secrets using:
#   python scripts/generate_secrets.py
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME
# ------------------------------------------------------------------------------
# Environment mode: 'development', 'staging', or 'production'.
# In 'production', default/insecure keys will raise fail-fast startup errors.
ENVIRONMENT=development

# Server bind host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Explicit Allowed CORS Origins (comma-separated list; wildcard '*' is rejected in production)
# Example: CORS_ORIGINS=https://classvission.anupmazumdar.me,https://classvision2-0.onrender.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE
# ------------------------------------------------------------------------------
# Development (SQLite local file):
DATABASE_URL=sqlite:///./classvision.db
# Production (PostgreSQL pool):
# DATABASE_URL=postgresql://postgres:yourpassword@db.render.com:5432/classvision

# ------------------------------------------------------------------------------
# 3. CRYPTOGRAPHIC SECRETS & BIOMETRIC PROTECTION (REQUIRED)
# ------------------------------------------------------------------------------
# Biometric Encryption Key (32-byte urlsafe base64 string for AES-128-CBC Fernet encryption)
# Mandatory in ALL environments before any face vector can be stored.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_ENCRYPTION_KEY=

# User Session & JWT Authentication Signing Key (minimum 32 characters)
JWT_SECRET=your-jwt-secret-signing-key-min32chars

# Rolling 6-Digit Session Code HMAC Secret Key (minimum 32 characters)
SESSION_CODE_SECRET=your-session-code-hmac-secret-min32chars

# Cryptographic Single-Use Attendance Verification Ticket HMAC Key (minimum 32 characters)
ATTENDANCE_TICKET_SECRET=your-attendance-ticket-hmac-secret-min32chars

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & DEFAULT ADMIN SEED
# ------------------------------------------------------------------------------
# Admin seed credentials (auto-created on initial database startup if no admin exists)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@classvision.local
ADMIN_PASSWORD=your-secure-admin-password

# Optional alias for domain typo resilience (e.g. admin@classvission.local)
ADMIN_ALIAS_EMAIL=

# Token & Session Expiration Policies
TOKEN_EXPIRE_HOURS=8
CODE_EXPIRATION_SECONDS=30
TICKET_EXPIRATION_SECONDS=15

# ------------------------------------------------------------------------------
# 5. FACIAL BIOMETRIC PIPELINE TUNING
# ------------------------------------------------------------------------------
# Cosine similarity matching threshold (0.75 - 0.85; 0.78 recommended for multi-angle registration)
FACE_SIMILARITY=0.78

# Maximum allowed Base64 image payload size (characters; ~7,000,000 chars ~= 5MB raw image)
MAX_IMAGE_BASE64_CHARS=7000000

# ------------------------------------------------------------------------------
# 6. DISTRIBUTED CACHING & RATE LIMITING (OPTIONAL)
# ------------------------------------------------------------------------------
# Redis connection string for multi-instance distributed rate limiting
# Example: REDIS_URL=redis://default:password@redis-host.render.com:6379
REDIS_URL=
